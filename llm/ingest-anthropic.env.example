# ── Ingestion profile: anthropic ────────────────────────────────────────────────
# Selected by INGEST_PROFILE=anthropic. Both IR phases — FILE_* (one long prompt per file) and
# UNIT_* (tens of thousands of short ones per repo) — on the Anthropic API. Self-contained: both
# phase credentials are stated here so this profile works whatever LLM_PROFILE names.
FILE_LLM_PROVIDER=anthropic
FILE_LLM_API_KEY=replace-me-in-stack-settings
FILE_SMART_MODELS=claude-haiku-4-5-20251001
FILE_SMARTER_MODELS=claude-haiku-4-5-20251001
FILE_SMARTEST_MODELS=claude-sonnet-5

UNIT_LLM_PROVIDER=anthropic
UNIT_LLM_API_KEY=replace-me-in-stack-settings
UNIT_SMART_MODELS=claude-haiku-4-5-20251001
UNIT_SMARTER_MODELS=claude-haiku-4-5-20251001
UNIT_SMARTEST_MODELS=claude-sonnet-5
