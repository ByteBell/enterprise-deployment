# ── Ingestion profile: bedrock ──────────────────────────────────────────────────
# Selected by INGEST_PROFILE=bedrock. Both IR phases on AWS Bedrock. *_BEDROCK_REGION is stated per
# phase so this profile works whatever LLM_PROFILE names (BEDROCK_REGION belongs to the deployment
# route and may be unset). Ids are Bedrock inference-profile ids, cross-region prefixed.
FILE_LLM_PROVIDER=bedrock
FILE_LLM_API_KEY=
FILE_BEDROCK_REGION=us-east-1
FILE_SMART_MODELS=us.openai.gpt-5.6-luna
FILE_SMARTER_MODELS=us.openai.gpt-oss-120b-1:0
FILE_SMARTEST_MODELS=us.anthropic.claude-sonnet-5

UNIT_LLM_PROVIDER=bedrock
UNIT_LLM_API_KEY=
UNIT_BEDROCK_REGION=us-east-1
UNIT_SMART_MODELS=us.openai.gpt-oss-120b-1:0
UNIT_SMARTEST_MODELS=us.qwen.qwen3-coder-next
