# ── Fallback profile: openai ────────────────────────────────────────────────────
# Selected by FALLBACK_PROFILE=openai. Where a call goes while the ACTIVE provider (LLM_PROFILE) is
# refusing on capacity (HTTP 429 / 503), for 120 s at a time. Self-contained, and it may not name
# the same provider as LLM_PROFILE (refused at boot).
FALLBACK_LLM_PROVIDER=openai
FALLBACK_LLM_API_KEY=replace-me-in-stack-settings
FALLBACK_SMART_MODELS=gpt-5.6-luna
# The MCP summary tier (query enrichment) reads FALLBACK_SMARTER_MODELS — ONE id, as in the LLM profiles.
FALLBACK_SMARTER_MODELS=gpt-5.6-luna
FALLBACK_SMARTEST_MODELS=gpt-luna-latest
AGENT_FALLBACK_LLM_INPUT_PRICE=0.1
AGENT_FALLBACK_LLM_OUTPUT_PRICE=0.5