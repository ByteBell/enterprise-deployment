# Anthropic
# Claude directly from the Anthropic API, with an sk-ant- key. Ids are Anthropic model ids, sent as
# written. Serves every slot, the public agent included (through Anthropic's OpenAI-compatible route).

PROVIDER=anthropic
API_KEY=replace-me-in-stack-settings

SMART_MODELS=claude-haiku-4-5-20251001
SMARTER_MODELS=claude-haiku-4-5-20251001
SMARTEST_MODELS=claude-sonnet-5

# Claude 5 models think adaptively by default and this route has no effort field, so the effort below
# is not sent; thinking still counts against the ceiling.
AGENT_BASE_URL=https://api.anthropic.com/v1
AGENT_MODEL=claude-sonnet-5
AGENT_REASONING_EFFORT=medium
AGENT_MAX_COMPLETION_TOKENS=8096
