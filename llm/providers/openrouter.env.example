# OpenRouter
# One key for hundreds of hosted models; ids are OpenRouter slugs (vendor/model). Every slot can use
# it, including the public agent. Not every model reads reasoning_effort — one that ignores it thinks
# as it always does, silently.

PROVIDER=openrouter
API_KEY=replace-me-in-stack-settings

SMART_MODELS=qwen/qwen3.8-flash,openai/gpt-oss-120b,deepseek/deepseek-v4-flash-0731
SMARTER_MODELS=deepseek/deepseek-v4-flash-0731
SMARTEST_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-flash,minimax/minimax-m3

AGENT_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL=deepseek/deepseek-v4-pro
AGENT_REASONING_EFFORT=medium
AGENT_MAX_COMPLETION_TOKENS=8096
