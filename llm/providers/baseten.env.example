# Baseten
# DeepSeek on Baseten's Model APIs. Ids are catalogue slugs and CASE-SENSITIVE — a wrong one is not
# an error, every draw that picks it silently falls through to the next model. Serves ingestion,
# fallback and the public agent; the answers slot has no Baseten client.

PROVIDER=baseten
API_KEY=replace-me-in-stack-settings

SMART_MODELS=deepseek-ai/DeepSeek-V4-Flash-0731,deepseek-ai/DeepSeek-V4.1-Flash
SMARTER_MODELS=deepseek-ai/DeepSeek-V4-Flash-0731
SMARTEST_MODELS=deepseek-ai/DeepSeek-V4-Pro-0813

# Reasoning is charged against the completion ceiling on this provider: at high/4096 a review was cut
# off mid-sentence with no tool calls; at medium/8096 it finished. Raise the ceiling before the effort.
AGENT_BASE_URL=https://inference.baseten.co/v1
AGENT_MODEL=deepseek-ai/DeepSeek-V4-Pro-0813
AGENT_REASONING_EFFORT=medium
AGENT_MAX_COMPLETION_TOKENS=24000

# The issue harnesses (public-agent src/harness/): the paid tier's embedding and explorer, their fallback, and the
# prices the ranking reports use. Prices are USD per million tokens.
HARNESS_EMBEDDING_MODEL=gemini-embedding-001
HARNESS_EMBEDDING_INPUT_PRICE=0.15
HARNESS_EXPLORER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017-Fast
HARNESS_EXPLORER_INPUT_PRICE=0.6
HARNESS_EXPLORER_CACHED_INPUT_PRICE=0.6
HARNESS_EXPLORER_OUTPUT_PRICE=2.4
HARNESS_EXPLORER_FALLBACK_MODEL=deepseek-ai/DeepSeek-V4-Pro-0813
HARNESS_EXPLORER_FALLBACK_INPUT_PRICE=1.32
HARNESS_EXPLORER_FALLBACK_CACHED_INPUT_PRICE=1.32
HARNESS_EXPLORER_FALLBACK_OUTPUT_PRICE=3.96
HARNESS_CLAUDE_MODEL=claude-opus-5-5
HARNESS_INDEXING_PRICE_A_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
HARNESS_INDEXING_PRICE_A_INPUT=0.30
HARNESS_INDEXING_PRICE_A_OUTPUT=1.20
HARNESS_INDEXING_PRICE_B_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
HARNESS_INDEXING_PRICE_B_INPUT=0.0443
HARNESS_INDEXING_PRICE_B_OUTPUT=0.30
