# Baseten
# DeepSeek on Baseten's Model APIs. Ids are catalogue slugs and CASE-SENSITIVE — a wrong one is not
# an error, every draw that picks it silently falls through to the next model. Serves ingestion,
# fallback and the public agent; the answers slot has no Baseten client.

PROVIDER=baseten
API_KEY=replace-me-in-stack-settings

SMART_MODELS=deepseek-ai/DeepSeek-V4-Flash-0731,deepseek-ai/DeepSeek-V4.1-Flash
SMARTER_MODELS=deepseek-ai/DeepSeek-V4-Flash-0731
SMARTEST_MODELS=deepseek-ai/DeepSeek-V4-Pro

# Reasoning is charged against the completion ceiling on this provider: at high/4096 a review was cut
# off mid-sentence with no tool calls; at medium/8096 it finished. Raise the ceiling before the effort.
AGENT_BASE_URL=https://inference.baseten.co/v1
AGENT_MODEL=deepseek-ai/DeepSeek-V4-Pro
AGENT_REASONING_EFFORT=medium
AGENT_MAX_COMPLETION_TOKENS=8096
