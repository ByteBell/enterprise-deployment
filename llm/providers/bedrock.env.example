# AWS Bedrock
# A Bedrock API key (ABSK…) and the region it serves. Ids are inference-profile ids, cross-region
# prefixed (us.…). Not usable for the public agent.

PROVIDER=bedrock
API_KEY=replace-me-in-stack-settings
REGION=us-east-1

SMART_MODELS=us.openai.gpt-oss-120b-1:0
SMARTER_MODELS=us.openai.gpt-oss-120b-1:0
SMARTEST_MODELS=us.anthropic.claude-sonnet-5
