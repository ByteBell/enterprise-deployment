# OpenAI
# Models directly from the OpenAI API, with an sk- key. Ids are OpenAI model ids, sent as written.
# Serves every slot, the public agent included.

PROVIDER=openai
API_KEY=replace-me-in-stack-settings

SMART_MODELS=gpt-5.6-luna
SMARTER_MODELS=gpt-5.6-luna
SMARTEST_MODELS=gpt-luna-latest

# Sent as reasoning_effort + max_completion_tokens, which is what OpenAI's reasoning models take;
# reasoning counts against the ceiling.
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-luna-latest
AGENT_REASONING_EFFORT=medium
AGENT_MAX_COMPLETION_TOKENS=8096
