# Google Gemini (Vertex AI Express)
# A Vertex Express key, bound to the vertex-express@<project> service account. Quota is per PROJECT,
# not per key: under fan-out the host answers 429 RESOURCE_EXHAUSTED. Ids are publisher-qualified
# (google/…). Not usable for the public agent.

PROVIDER=gemini
API_KEY=replace-me-in-stack-settings
GEMINI_API_SURFACE=vertex-express
GOOGLE_CLOUD_PROJECT=replace-me-in-stack-settings
GOOGLE_CLOUD_LOCATION=global

SMART_MODELS=google/gemini-3.8-flash,google/gemini-3.7-flash
SMARTER_MODELS=google/gemini-3.7-flash
SMARTEST_MODELS=google/gemini-3.8-flash,google/gemini-3.1-pro-preview,google/gemini-3.7-flash
