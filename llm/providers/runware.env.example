# Runware
# One key, many vendors behind an OpenAI-format endpoint; ids are Runware AIR ids (vendor:model@version).
# Public agent only: the answers and ingest routes have no Runware client.

PROVIDER=runware
API_KEY=replace-me-in-stack-settings

AGENT_BASE_URL=https://api.runware.ai/v1
AGENT_MODEL=minimax:m3.1@flash
AGENT_LLM_INPUT_PRICE=0.15
AGENT_LLM_OUTPUT_PRICE=0.60
AGENT_REASONING_EFFORT=high
AGENT_MAX_COMPLETION_TOKENS=30000
