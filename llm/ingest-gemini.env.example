# ── Ingestion profile: gemini (Vertex AI Express) ───────────────────────────────
# Selected by INGEST_PROFILE=gemini. Both IR phases on Google. Self-contained: the surface, project
# and both phase credentials are stated here so this profile works whatever LLM_PROFILE names.
# Note the quota warning in gemini.env — the unit phase alone is tens of thousands of calls per repo,
# and Vertex Express quota is per project.
GEMINI_API_SURFACE=vertex-express
GOOGLE_CLOUD_PROJECT=replace-me-in-stack-settings
GOOGLE_CLOUD_LOCATION=global

FILE_LLM_PROVIDER=gemini
FILE_LLM_API_KEY=replace-me-in-stack-settings
FILE_SMART_MODELS=google/gemini-3.1-pro-preview,google/gemini-2.5-flash-lite,google/gemini-3.5-flash,google/gemini-3.1-flash-lite,google/gemini-3-flash-preview,google/gemini-3.7-flash,google/gemini-3.5-flash-lite
FILE_SMARTER_MODELS=google/gemini-3.1-pro-preview,google/gemini-3.7-flash,google/gemini-3-flash-preview
FILE_SMARTEST_MODELS=google/gemini-3.1-pro-preview,google/gemini-3.7-flash

UNIT_LLM_PROVIDER=gemini
UNIT_LLM_API_KEY=replace-me-in-stack-settings
UNIT_SMART_MODELS=google/gemini-3.7-flash,google/gemini-2.5-flash-lite,google/gemini-3-flash-preview,google/gemini-3.5-flash,google/gemini-3.1-flash-lite,google/gemini-3.1-pro-preview,google/gemini-3.5-flash-lite
UNIT_SMARTER_MODELS=google/gemini-3.1-pro-preview,google/gemini-3.7-flash,google/gemini-3-flash-preview
UNIT_SMARTEST_MODELS=google/gemini-3.1-pro-preview,google/gemini-3.7-flash
