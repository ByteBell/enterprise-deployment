# ── Fallback profile: anthropic ─────────────────────────────────────────────────
# Selected by FALLBACK_PROFILE=anthropic. Where a call goes while the ACTIVE provider (LLM_PROFILE) is
# refusing on capacity (HTTP 429 / 503), for 120 s at a time. Self-contained, and it may not name
# the same provider as LLM_PROFILE (refused at boot).
FALLBACK_LLM_PROVIDER=anthropic
FALLBACK_LLM_API_KEY=replace-me-in-stack-settings
FALLBACK_SMART_MODELS=claude-haiku-4-5-20251001
# The MCP summary tier (query enrichment) reads FALLBACK_SMARTER_MODELS — ONE id, as in the LLM profiles.
FALLBACK_SMARTER_MODELS=claude-haiku-4-5-20251001
FALLBACK_SMARTEST_MODELS=claude-sonnet-5
