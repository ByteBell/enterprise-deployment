# ── Agent profile: anthropic ────────────────────────────────────────────────────
# Selected by AGENT_PROFILE=anthropic. Every key here belongs to Anthropic and to no other provider;
# a switch is a change of AGENT_PROFILE in the env file, never an edit here.
#
# See agent-baseten.env.example for what this slot is and why it is separate from LLM_PROFILE.
# Anthropic's OpenAI-compatible route: tool calls work as on every other agent endpoint.
AGENT_LLM_BASE_URL=https://api.anthropic.com/v1
AGENT_LLM_API_KEY=replace-me-in-stack-settings
AGENT_MODEL=claude-sonnet-5

# What this model costs, in USD per million tokens, as printed on every review's report. REQUIRED:
# config.ts rejects an unset or non-numeric value at startup rather than reporting a run as free.
# IT BELONGS TO THE MODEL NAMED ABOVE, so AGENT_MODEL and these two change together — a model swap
# that leaves a stale price here reports the new model's tokens at the old model's rate and nothing
# says so. Anthropic's published first-party rate for claude-sonnet-5.
AGENT_LLM_INPUT_PRICE=2.00
AGENT_LLM_OUTPUT_PRICE=10.00

# Operating mode. Claude 5 models think adaptively by default and this route has no field for effort,
# so AGENT_REASONING_EFFORT is required but not sent here. Thinking still counts against the
# completion ceiling — raise the ceiling, not the effort, if a turn is cut off before its tool call.
AGENT_REASONING_EFFORT=medium
AGENT_MAX_COMPLETION_TOKENS=8096
