# ── Ingestion profile: baseten ──────────────────────────────────────────────────
# Selected by INGEST_PROFILE=baseten. Both IR phases on Baseten's Model APIs. `baseten` is hosted
# and billed, so its credential is REQUIRED — a phase naming it without a key fails at boot.
#
# Ids are Baseten catalogue slugs and are CASE-SENSITIVE (`deepseek-ai/DeepSeek-V4-Pro`, not
# `deepseek-ai/deepseek-v4-pro`). A wrong id is not an error here: every draw that picks it fails
# and falls back, silently, to the next model.
#
# Rungs are walked cheapest-first and FLATTENED into one chain: SMART, then SMARTEST. SMARTER is
# absent on purpose — the chain is Flash → Flash fallback → Pro.
FILE_LLM_PROVIDER=baseten
FILE_LLM_API_KEY=replace-me-in-stack-settings
FILE_SMART_MODELS=deepseek-ai/DeepSeek-V4-Flash-0731,deepseek-ai/DeepSeek-V4.1-Flash
FILE_SMARTEST_MODELS=deepseek-ai/DeepSeek-V4-Pro

UNIT_LLM_PROVIDER=baseten
UNIT_LLM_API_KEY=replace-me-in-stack-settings
UNIT_SMART_MODELS=deepseek-ai/DeepSeek-V4-Flash-0731,deepseek-ai/DeepSeek-V4.1-Flash
UNIT_SMARTEST_MODELS=deepseek-ai/DeepSeek-V4-Pro
