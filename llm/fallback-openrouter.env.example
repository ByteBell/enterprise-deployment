# ── Fallback profile: openrouter ────────────────────────────────────────────────
# Selected by FALLBACK_PROFILE=openrouter. Where a call goes while the ACTIVE provider (Vertex, per
# LLM_PROFILE=gemini) is refusing on capacity (HTTP 429 / 503): the first refusal sends that call
# here and trips the provider; every call for the next 120 s comes here directly; then the provider
# is probed again. A fallback is self-contained — by definition it is not the provider that just
# failed, so it can share nothing with it — and it may not name the same provider as LLM_PROFILE
# (refused at boot).
FALLBACK_LLM_PROVIDER=openrouter
FALLBACK_LLM_API_KEY=replace-me-in-stack-settings
FALLBACK_SMART_MODELS=qwen/qwen3.8-flash,openai/gpt-oss-120b,deepseek/deepseek-v4-flash-latest,z-ai/glm-5.3-flash,google/gemini-2.5-flash-lite,qwen/qwen3.7-flash
# The MCP summary tier (query enrichment) reads FALLBACK_SMARTER_MODELS; the answer tier reads
# FALLBACK_SMARTEST_MODELS. ONE enrichment id, for the same reason as in the LLM profiles.
FALLBACK_SMARTER_MODELS=deepseek/deepseek-v4-flash-0731
FALLBACK_SMARTEST_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-flash,minimax/minimax-m3
