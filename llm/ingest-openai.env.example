# ── Ingestion profile: openai ───────────────────────────────────────────────────
# Selected by INGEST_PROFILE=openai. Both IR phases — FILE_* (one long prompt per file) and
# UNIT_* (tens of thousands of short ones per repo) — on the OpenAI API. Self-contained: both
# phase credentials are stated here so this profile works whatever LLM_PROFILE names.
FILE_LLM_PROVIDER=openai
FILE_LLM_API_KEY=replace-me-in-stack-settings
FILE_SMART_MODELS=gpt-5.6-luna
FILE_SMARTER_MODELS=gpt-5.6-luna
FILE_SMARTEST_MODELS=gpt-luna-latest

UNIT_LLM_PROVIDER=openai
UNIT_LLM_API_KEY=replace-me-in-stack-settings
UNIT_SMART_MODELS=gpt-5.6-luna
UNIT_SMARTER_MODELS=gpt-5.6-luna
UNIT_SMARTEST_MODELS=gpt-luna-latest
