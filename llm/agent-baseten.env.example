# ── Agent profile: baseten ──────────────────────────────────────────────────────
# Selected by AGENT_PROFILE=baseten. Every key here belongs to Baseten and to no other provider;
# a switch is a change of AGENT_PROFILE in the env file, never an edit here.
#
# THIS IS THE PUBLIC-AGENT ROUTE ONLY — the public repo page's question and pull-request review
# runs. It is a separate slot from LLM_PROFILE because the two genuinely differ: this surface is a
# long tool-calling loop against the code graph and wants one strong model with reasoning on, while
# the deployment route wants the cheap-first tier chain. Riding LLM_PROFILE would force one choice
# on both.
#
# The four move TOGETHER. A base URL, the credential that endpoint issued, a model id that endpoint
# answers to, and the operating mode that model needs. Mixing one provider's key with another's base
# is a 401 that reads like an expired key.
AGENT_LLM_BASE_URL=https://inference.baseten.co/v1
AGENT_LLM_API_KEY=replace-me-in-stack-settings
AGENT_MODEL=deepseek-ai/DeepSeek-V4-Pro-0813

# What this model costs, in USD per million tokens, as printed on every review's report. REQUIRED:
# config.ts rejects an unset or non-numeric value at startup rather than reporting a run as free.
# IT BELONGS TO THE MODEL NAMED ABOVE, so AGENT_MODEL and these two change together — a model swap
# that leaves a stale price here reports the new model's tokens at the old model's rate and nothing
# says so. Read from Baseten's own catalog: GET https://inference.baseten.co/v1/models reports `pricing` per model.
AGENT_LLM_INPUT_PRICE=1.32
AGENT_LLM_OUTPUT_PRICE=3.96

# Operating mode. REASONING IS CHARGED AGAINST THE COMPLETION CEILING on this provider, whatever the
# docs say, so these two are one setting in two fields.
#
# Measured on a review of tldraw#10571 (2026-09-21): at high/4096 the model reasoned out a verdict
# for every hunk and was then cut off mid-sentence with no tool calls at all — a turn that cost a
# full completion and delivered nothing, ending the review having cleared 0 of 13 hunks. At
# medium/8096 the same review cleared 13 of 13. Raise the ceiling before lowering the effort if you
# need more thinking: an empty turn is the failure mode, not a shallow one.
AGENT_REASONING_EFFORT=medium
AGENT_MAX_COMPLETION_TOKENS=24000

# THE DROP JUDGE — a second model that decides every drop a PR review proposes (a file the triage
# would abandon, a finding the final check would remove). A different model from the agent's on
# purpose: the one proposing a drop does not get to confirm it. Required: a review fails at its first
# drop without it. On this profile it shares the endpoint and key above; its effort and token cap
# default to the AGENT_* settings. Baseten ids are case-sensitive — GET /v1/models lists them, with
# the prices below.
JUDGE_MODEL=zai-org/GLM-5.3
JUDGE_LLM_INPUT_PRICE=1.4
JUDGE_LLM_OUTPUT_PRICE=4.4
# Kimi-K3, tried as the judge on verl #6641, costs about twice GLM-5.3's input price and three times its output:
# JUDGE_MODEL=moonshotai/Kimi-K3  JUDGE_LLM_INPUT_PRICE=3  JUDGE_LLM_OUTPUT_PRICE=15

# THE PLANNER — the model for the tool-less calls that decide what every later search looks for:
# Verify Code's cross-repository plan and the PR review's analysis. Required: a run fails at its
# first planning call without it. Same endpoint and key as the agent.
PLANNER_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
PLANNER_LLM_INPUT_PRICE=0.13
PLANNER_LLM_OUTPUT_PRICE=0.26

# THE ISSUE HARNESSES — the models of services/public-agent/src/harness, the harness ISSUE_HARNESS names.
# Required by the harness that uses them, read by nothing else.
# EMBEDDING: step 1 of embedding-seeds-lambdamart and of embedding-seeds-plumbline-llm-explorer-lambdamart, the
# issue against every file's Plumbline purpose + summary. A Gemini model on Vertex: its key, project and location
# are llm/gemini.env's, not this profile's. The price is USD per million input tokens.
HARNESS_EMBEDDING_MODEL=gemini-embedding-001
HARNESS_EMBEDDING_INPUT_PRICE=0.15
# EXPLORER: step 2 of embedding-seeds-plumbline-llm-explorer-lambdamart, a Plumbline tool session started from the
# seeds. Same endpoint and key as the agent. The fallback answers from the first HTTP 429 on.
HARNESS_EXPLORER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017-Fast
HARNESS_EXPLORER_INPUT_PRICE=0.6
HARNESS_EXPLORER_CACHED_INPUT_PRICE=0.6
HARNESS_EXPLORER_OUTPUT_PRICE=2.4
HARNESS_EXPLORER_FALLBACK_MODEL=deepseek-ai/DeepSeek-V4-Pro-0813
HARNESS_EXPLORER_FALLBACK_INPUT_PRICE=1.32
HARNESS_EXPLORER_FALLBACK_CACHED_INPUT_PRICE=1.32
HARNESS_EXPLORER_FALLBACK_OUTPUT_PRICE=3.96
# The final judge of the ranking harnesses: reads the task against the top of the ranked list and names the files that must change.
HARNESS_FINAL_JUDGE_MODEL=moonshotai/Kimi-K3.1-Pro
HARNESS_FINAL_JUDGE_INPUT_PRICE=2
HARNESS_FINAL_JUDGE_OUTPUT_PRICE=10
# CLAUDE: claude-opus-5-5-agent-names-the-files-over-plumbline, one `claude -p` session per task over Plumbline. It
# runs on the account the claude CLI is signed in with, not on this profile's endpoint or key; the CLI prices each
# session itself.
HARNESS_CLAUDE_MODEL=claude-opus-5-5
# INDEXING: what Plumbline's index of each task's commit cost, beside the Claude harness's own cost in its report.
# The fresh tokens of the commit (cached excluded) are priced at two models' rates, USD per million tokens.
HARNESS_INDEXING_PRICE_A_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
HARNESS_INDEXING_PRICE_A_INPUT=0.30
HARNESS_INDEXING_PRICE_A_OUTPUT=1.20
HARNESS_INDEXING_PRICE_B_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
HARNESS_INDEXING_PRICE_B_INPUT=0.0443
HARNESS_INDEXING_PRICE_B_OUTPUT=0.30
