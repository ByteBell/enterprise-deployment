# ── Agent profile: runware ──────────────────────────────────────────────────────
# Selected by AGENT_PROFILE=runware. Every key here belongs to Runware and to no other provider;
# a switch is a change of AGENT_PROFILE in the env file, never an edit here.
#
# See agent-baseten.env.example for what this slot is and why it is separate from LLM_PROFILE.
#
# Runware fronts many vendors behind one OpenAI-format endpoint (docs: runware.ai/docs/platform/openai).
# Model ids are Runware AIR ids — `vendor:model@version` — not the vendor's own names, so
# `minimax:m3.1@flash` here is MiniMax-M3.1-Flash at MiniMax. The key is sent as a Bearer; the request
# takes `max_completion_tokens` and a top-level `reasoning_effort` (public-agent/src/llm.ts).
AGENT_LLM_BASE_URL=https://api.runware.ai/v1
AGENT_LLM_API_KEY=replace-me-in-stack-settings
AGENT_MODEL=minimax:m3.1@flash

# What this model costs, in USD per million tokens, as printed on every review's report. REQUIRED:
# config.ts rejects an unset or non-numeric value at startup rather than reporting a run as free.
# IT BELONGS TO THE MODEL NAMED ABOVE, so AGENT_MODEL and these two change together. These are
# MiniMax's list prices for M3.1 Flash (0.15 in / 0.60 out, 2026-10); Runware does not publish a
# per-model token price page, so confirm against the `cost` field Runware returns on a reply's usage
# — llm.ts stores it beside `priced` on every turn, so the two can be compared on any finished run.
AGENT_LLM_INPUT_PRICE=0.15
AGENT_LLM_OUTPUT_PRICE=0.60

# Operating mode — see agent-baseten.env.example for the measurement behind these two.
#
# M3.1 Flash's reasoning can be tuned but not turned off, and on MiniMax's own API thinking is charged
# against the completion ceiling: a ceiling too small ends a turn with finish_reason=length and no
# answer. Raise the ceiling before lowering the effort.
AGENT_REASONING_EFFORT=high
AGENT_MAX_COMPLETION_TOKENS=30000
