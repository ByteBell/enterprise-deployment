# ── Agent profile: openai ───────────────────────────────────────────────────────
# Selected by AGENT_PROFILE=openai. Every key here belongs to OpenAI and to no other provider; a
# switch is a change of AGENT_PROFILE in the env file, never an edit here.
#
# See agent-baseten.env.example for what this slot is and why it is separate from LLM_PROFILE.
AGENT_LLM_BASE_URL=https://api.openai.com/v1
AGENT_LLM_API_KEY=replace-me-in-stack-settings
AGENT_MODEL=gpt-luna-latest

# Operating mode — sent as `reasoning_effort` and `max_completion_tokens`, the fields OpenAI's
# reasoning models take. Reasoning counts against the ceiling: see agent-baseten.env.example for the
# measurement behind these two.
AGENT_REASONING_EFFORT=medium
AGENT_MAX_COMPLETION_TOKENS=8096
