# ── LLM profile: anthropic ──────────────────────────────────────────────────────
# Selected by LLM_PROFILE=anthropic. Claude directly from the Anthropic API, with an sk-ant- key.
# Every key here belongs to Anthropic and to no other provider; a switch is a change of LLM_PROFILE
# in the env file, never an edit here. Ids are Anthropic model ids, sent as written.
LLM_PROVIDER=anthropic
LLM_API_KEY=replace-me-in-stack-settings

# Tier chain, cheapest first. Each tier is a comma-separated LIST: a call picks one and rotates to
# the others on failure. The SUMMARY tier (stakeout's query enrichment) is ONE id — a rotating tier
# makes the ranked result a function of the draw rather than of the question.
SMART_MODEL_NAME=claude-haiku-4-5-20251001
SMARTER_MODEL_NAME=claude-haiku-4-5-20251001
SMARTEST_MODEL_NAME=claude-sonnet-5
