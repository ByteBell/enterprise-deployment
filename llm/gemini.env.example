# ── LLM profile: gemini (Vertex AI Express) ─────────────────────────────────────
# Selected by LLM_PROFILE=gemini. Every key here belongs to Google and to no other provider.
LLM_PROVIDER=gemini
LLM_API_KEY=replace-me-in-stack-settings

# Which Google endpoint `gemini` talks to. `vertex-express` because the key is bound to the
# vertex-express@<your-project> service account: generativelanguage.googleapis.com refuses
# it (403 API_KEY_SERVICE_BLOCKED) and aiplatform.googleapis.com wants it as ?key=, not a Bearer.
# Unset → ai-studio (an AI Studio key sent as a Bearer). The project and location are endpoint
# locators, not credentials; `global` resolves to the unprefixed aiplatform host.
GEMINI_API_SURFACE=vertex-express
GOOGLE_CLOUD_PROJECT=replace-me-in-stack-settings
GOOGLE_CLOUD_LOCATION=global

# Ids are written PUBLISHER-QUALIFIED (`google/…`): the vertex-express host requires that form and
# the code would add the prefix anyway, so this pins the ids to the surface they belong to.
SMART_MODEL_NAME=google/gemini-3.1-pro-preview,google/gemini-3.7-flash,google/gemini-3.1-flash-lite,google/gemini-2.5-flash-lite
# The SUMMARY tier — the model `stakeout`'s query enrichment runs on. ONE id, deliberately: a tier
# rotates per call, enrichment's output IS the query, and a rotating tier makes the ranked result
# a function of the draw rather than of the question.
SMARTER_MODEL_NAME=google/gemini-3.7-flash
SMARTEST_MODEL_NAME=google/gemini-3.1-pro-preview,google/gemini-3.7-flash

# Vertex Express is quota-bound per PROJECT, not per key. Under fan-out (four MCP replicas each
# enriching and answering) the host answers 429 RESOURCE_EXHAUSTED and the calls behind it time
# out; the rotation recovers, but the minute is lost. Raise the project's Gemini quota or move the
# ingestion phases to another provider (INGEST_PROFILE) before adding load here.
