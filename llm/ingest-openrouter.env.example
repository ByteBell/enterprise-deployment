# ── Ingestion profile: openrouter ───────────────────────────────────────────────
# Selected by INGEST_PROFILE=openrouter. The two IR phases — FILE_* (one long prompt per file) and
# UNIT_* (tens of thousands of short ones per repo) — on OpenRouter, each with its own tiers.
# Every tier is a LIST and EVERY model in it is tried before the tier escalates, so the free shelf
# in *_SMART_MODELS is what a call costs first and the paid tier above is what it costs after all
# of them have refused it.
FILE_LLM_PROVIDER=openrouter
FILE_LLM_API_KEY=
FILE_SMART_MODELS=z-ai/glm-5.3-flash,deepseek/deepseek-v4-flash-0731,openai/gpt-oss-120b,inclusionai/ling-3.0-flash-fin:free,tencent/hy3
FILE_SMARTER_MODELS=deepseek/deepseek-v4.1-flash,openai/gpt-luna-latest
FILE_SMARTEST_MODELS=deepseek/deepseek-v4.1-flash,deepseek/deepseek-v4-pro

UNIT_LLM_PROVIDER=openrouter
UNIT_LLM_API_KEY=
UNIT_SMART_MODELS=z-ai/glm-5.3-flash,deepseek/deepseek-v4-flash-0731,tencent/hy3,openai/gpt-oss-120b,poolside/laguna-s-2.1,qwen/qwen3.8-flash
UNIT_SMARTER_MODELS=deepseek/deepseek-v4.1-flash,openai/gpt-luna-latest
UNIT_SMARTEST_MODELS=deepseek/deepseek-v4-pro
