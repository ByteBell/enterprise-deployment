# ── LLM profile: openrouter ─────────────────────────────────────────────────────
# Selected by LLM_PROFILE=openrouter. Every key here belongs to OpenRouter and to no other
# provider; a switch is a change of LLM_PROFILE in the env file, never an edit here.
LLM_PROVIDER=openrouter
LLM_API_KEY=replace-me-in-stack-settings

# Tier chain, cheapest first. Each tier is a comma-separated LIST of interchangeable ids: a call
# picks one at random and rotates to the others on failure. Ids are OpenRouter ids.
SMART_MODEL_NAME=qwen/qwen3.8-flash,openai/gpt-oss-120b,deepseek/deepseek-v4-flash-0731
SMARTER_MODEL_NAME=tencent/hy3,minimax/minimax-m3,inception/mercury-2.5,openai/gpt-5.6-luna
SMARTEST_MODEL_NAME=openai/gpt-oss-120b,qwen/qwen3.8-flash,minimax/minimax-m3
