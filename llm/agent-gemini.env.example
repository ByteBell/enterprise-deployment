# ── Agent profile: gemini (Vertex AI Express) ───────────────────────────────────
# Selected by AGENT_PROFILE=gemini. Every key here belongs to Google and to no other provider;
# a switch is a change of AGENT_PROFILE in the env file, never an edit here.
#
# See agent-baseten.env.example for what this slot is and why it is separate from LLM_PROFILE, and
# services/public-agent/src/gemini.ts for how this endpoint differs from the others.
#
# The base URL is Vertex's OpenAI-compatible endpoint for ONE project and location; `global` is the
# unprefixed host. The key is a Vertex Express key bound to a service account in that project — it
# is sent as `?key=`, never as a Bearer. Model ids are publisher-qualified (`google/…`).
AGENT_LLM_BASE_URL=https://aiplatform.googleapis.com/v1/projects/<project>/locations/global/endpoints/openapi
AGENT_LLM_API_KEY=replace-me
AGENT_MODEL=google/gemini-3.8-flash

# What this model costs, in USD per million tokens, as printed on every review's report. REQUIRED.
# IT BELONGS TO THE MODEL NAMED ABOVE, so AGENT_MODEL and these two change together. Output includes
# the thinking tokens: Vertex bills them as output and gemini.ts counts them into each reply.
AGENT_LLM_INPUT_PRICE=0.75
AGENT_LLM_OUTPUT_PRICE=3.75

# Operating mode. Sent as top-level `reasoning_effort` (low, medium, high); thinking counts against
# the completion ceiling, so raise the ceiling before lowering the effort.
AGENT_REASONING_EFFORT=high
AGENT_MAX_COMPLETION_TOKENS=30000
