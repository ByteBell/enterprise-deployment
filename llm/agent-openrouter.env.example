# ── Agent profile: openrouter ───────────────────────────────────────────────────
# Selected by AGENT_PROFILE=openrouter. Every key here belongs to OpenRouter and to no other
# provider; a switch is a change of AGENT_PROFILE in the env file, never an edit here.
#
# See agent-baseten.env.example for what this slot is and why it is separate from LLM_PROFILE.
AGENT_LLM_BASE_URL=https://openrouter.ai/api/v1
AGENT_LLM_API_KEY=replace-me-in-stack-settings
AGENT_MODEL=deepseek/deepseek-v4-pro

# Operating mode — see agent-baseten.env.example for the measurement behind these two.
#
# OpenRouter fronts many models and NOT all of them read `reasoning_effort`; a model that ignores it
# simply thinks as it always does, which is a silent difference rather than an error. Check the
# model you name here before assuming the effort took.
AGENT_REASONING_EFFORT=medium
AGENT_MAX_COMPLETION_TOKENS=8096
