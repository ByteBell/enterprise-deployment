# ── LLM profile: openai ─────────────────────────────────────────────────────────
# Selected by LLM_PROFILE=openai. Models directly from the OpenAI API, with an sk- key. Every key
# here belongs to OpenAI and to no other provider; a switch is a change of LLM_PROFILE in the env
# file, never an edit here. Ids are OpenAI model ids, sent as written.
LLM_PROVIDER=openai
LLM_API_KEY=replace-me-in-stack-settings

# Tier chain, cheapest first. Each tier is a comma-separated LIST: a call picks one and rotates to
# the others on failure. The SUMMARY tier (stakeout's query enrichment) is ONE id — a rotating tier
# makes the ranked result a function of the draw rather than of the question.
SMART_MODEL_NAME=gpt-5.6-luna
SMARTER_MODEL_NAME=gpt-5.6-luna
SMARTEST_MODEL_NAME=gpt-luna-latest
