# ── Fallback profile: gemini (Vertex AI Express) ────────────────────────────────
# Selected by FALLBACK_PROFILE=gemini. Where a call goes while the ACTIVE provider (LLM_PROFILE) is
# refusing on capacity (HTTP 429 / 503): the first refusal sends that call here and trips the
# provider; every call for the next 120 s comes here directly; then the provider is probed again.
# A fallback may not name the same provider as LLM_PROFILE (refused at boot) — so not with
# LLM_PROFILE=gemini. Self-contained: the surface and project are stated here too.
#
# Ships with a dummy key and project: enter the real ones on the dashboard's Stack Settings page.
GEMINI_API_SURFACE=vertex-express
GOOGLE_CLOUD_PROJECT=replace-me-in-stack-settings
GOOGLE_CLOUD_LOCATION=global
FALLBACK_LLM_PROVIDER=gemini
FALLBACK_LLM_API_KEY=replace-me-in-stack-settings
FALLBACK_SMART_MODELS=google/gemini-3.8-flash,google/gemini-3.7-flash
# The MCP summary tier (query enrichment) reads FALLBACK_SMARTER_MODELS — ONE id, as in the LLM profiles.
FALLBACK_SMARTER_MODELS=google/gemini-3.7-flash
FALLBACK_SMARTEST_MODELS=google/gemini-3.8-flash,google/gemini-3.1-pro-preview,google/gemini-3.7-flash
