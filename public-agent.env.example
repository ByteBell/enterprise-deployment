# public-agent only — read by public-agent-1 and public-agent-2 on top of the shared env files.
# cp public-agent.env.example public-agent.env

# THE DROP JUDGE — a second model that decides every drop a PR review proposes (a file the triage
# would abandon, a finding the final pass or final check would remove). Required: a review fails at
# its first drop without it. Endpoint, key, effort and token cap default to the AGENT_* settings.
JUDGE_MODEL=z-ai/glm-5.3
# USD per million tokens, for the run's cost line.
JUDGE_LLM_INPUT_PRICE=0.079
JUDGE_LLM_OUTPUT_PRICE=4.8
# JUDGE_LLM_BASE_URL=
# JUDGE_LLM_API_KEY=
# JUDGE_REASONING_EFFORT=
# JUDGE_MAX_COMPLETION_TOKENS=

# THE PLANNER — the model for the tool-less calls that decide what every later search looks for:
# Verify Code's cross-repository plan (the rewritten query and its search lines) and the PR review's
# analysis (its questions and the strings to look for). Required: a run fails at its first planning
# call without it. Endpoint, key, effort and token cap default to the AGENT_* settings.
PLANNER_MODEL=xiaomi/mimo-v2.6-pro
# USD per million tokens, for the run's cost line.
PLANNER_LLM_INPUT_PRICE=0.435
PLANNER_LLM_OUTPUT_PRICE=0.87
# PLANNER_LLM_BASE_URL=
# PLANNER_LLM_API_KEY=
# PLANNER_REASONING_EFFORT=
# PLANNER_MAX_COMPLETION_TOKENS=
