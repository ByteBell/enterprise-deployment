# =============================================================================
# Plumbline — enterprise deployment · LOCALHOST
# =============================================================================
#
#   cp .env.localhost.example .localhost.env    then fill in every [REQUIRED] value below.
#   make up localhost
#
# THIS IS THE SELF-CONTAINED LOCAL TEMPLATE — a laptop reached at http://localhost, with
# MongoDB and Neo4j started HERE as containers (the `localhost` compose profile) rather than
# reached on some other machine. The database addresses below already point at those
# containers, and files never leave ./temp (FILE_STORAGE_BACKEND=local — no S3 bucket). A Neo4j
# password, the registry credential, the secrets and the provider keys are what is left to fill in.
#
# The other two templates are the same document with different values:
#
#   cp .env.example .dev.env                      ByteBell monorepo only: its source, reloaded
#   make up dev                                   on save, databases you already run elsewhere
#
#   cp .env.production.example .production.env    a real host on its own domain
#   make up prod
#
# Keep the files separate and complete. Do not make one include another:
# when two files both define a key, the last one silently wins and the losing
# definition still reads as though it were in force.
#
# `.localhost.env` is gitignored and never leaves your machine. Everything here is read at
# container START: a service missing a required value exits immediately with the
# variable's name, rather than failing later on a user's first request.
#
# Values with a default shown are already correct for a standard deployment —
# change them only if you know why.
# =============================================================================


# =============================================================================
# 1. IMAGES — where they come from                                  [REQUIRED]
# =============================================================================
# Every service ships from ONE private Docker Hub repository, told apart by tag:
#
#     docker.io/bbplumbline/plumbline-containers:ingestion-engine-5.0.2
#      └registry┘ └namespace ┘ └──── repo ────┘ └─── service ───┘└ ver ┘
#
# so IMAGE_REPO_PREFIX is the NAMESPACE and never contains a slash.
# ── Images: how to PULL and how to PUSH ────────────────────────────────────────
#
# The five keys below name the registry and the credential. They serve two different jobs, and
# the credential's SCOPE is the only thing that changes between them.
#
# PULLING — every server, every day.
#   REGISTRY_TOKEN needs only READ access (Docker Hub: Account Settings → Personal access tokens
#   → "Public Repo Read-only" or "Read"). Then, with IMAGE_TAG set as described at that key:
#       make preflight prod      names anything missing, before a byte is pulled
#       make update prod         pull the tag, recreate only the services whose image changed
#       make verify prod         prove it is serving, not merely "up"
#   IMAGE_TAG blank = the newest release on the hub, looked up by version. Pin it to hold a
#   server still, and to roll back: a pinned tag is never looked up or moved.
#   (In the ByteBell monorepo: the same targets with `dev`, or nothing — dev is the default.)
#
# PUSHING — the release machine only, and only when cutting a version.
#   REGISTRY_TOKEN needs READ & WRITE. A read-only token authenticates fine and then fails the
#   first push with "access token has insufficient scopes"; that message means scope, not a typo.
#       make publish VERSION=x.y.z SEVERITY=optional CHANGELOG='what changed'
#   builds every service multi-arch, pushes all seven tags, then writes .version — so .version
#   is never bumped by hand. Pass SEVERITY explicitly: the Makefile's own default is `critical`,
#   which is what clients read to decide whether an update is forced.
#
# PRECEDENCE, and why a stale token here bites: the Makefile `-include`s this file and `export`s
# every key, so a value in this file OUTRANKS one exported from your shell. To use a different
# credential for one run, put it on the make command line, which outranks both:
#       make publish VERSION=x.y.z REGISTRY_USERNAME=... REGISTRY_TOKEN=...
#
IMAGE_REGISTRY=docker.io
IMAGE_REPO_PREFIX=bbplumbline
IMAGE_REPO_NAME=plumbline-containers

# The release to run. LEAVE IT BLANK to get the newest published one — `make up`
# asks the registry which that is and prints what it picked.
#
# Pin it to a version (e.g. 5.2.1) when you want this deployment to stay put, and
# to roll back: a pinned tag is never looked up or moved. There is no `latest` tag
# to point at, because every tag names a service AND a version
# (ingestion-engine-5.2.1), which is why the newest has to be looked up.
#
# `local` runs images built on this machine by `make build` in the ByteBell monorepo
# (<service>-local); nothing is pulled. Only meaningful inside that monorepo.
IMAGE_TAG=

# Read-only Docker Hub credentials, issued to you by ByteBell. They can pull and
# nothing else. `make login` uses them, and so does the IMAGE_TAG lookup above —
# leaving IMAGE_TAG blank needs these to be right.          [REQUIRED, both]
REGISTRY_USERNAME=
REGISTRY_TOKEN=


# =============================================================================
# 2. CORE
# =============================================================================
# `development` disables authentication. Fine on a laptop; NEVER on a reachable host — that is
# what .env.production.example is for.
NODE_ENV=development

# The environment name, and so the prefix of every container (local-admin, local-knowledge-2…).
# install.sh refuses any other value for this environment.
COMPOSE_PROJECT_NAME=local

# Where the browser reaches this deployment — used in links the services generate
# (invites, OAuth callbacks). Include the scheme, no trailing slash. [REQUIRED]
#
# It is ALSO the one origin sign-in trusts. Whatever is in the browser's address bar must match
# this exactly, scheme and port included: reach a deployment set to https://plumbline.acme.com
# over http://10.0.0.5 instead and every sign-in fails with a bare 403, no message, while the
# rest of the site works normally. If you need a second address to work, add it below.
FRONTEND_BASE_URL=http://localhost:8081

# Host ports. `local` sits beside a `dev` stack on the same machine, which holds 80, 8404 and
# 6379, so it publishes on its own: the stack at http://localhost:8081 (its MCP endpoint is
# http://localhost:8081/mcp), HAProxy stats on 8405, Redis on loopback 6380. Unset, the compose
# file uses 80 / 8404 / 6379. FRONTEND_BASE_URL and the SEED_* addresses must carry the same port.
HTTP_HOST_PORT=8081
HAPROXY_STATS_HOST_PORT=8405
REDIS_HOST_PORT=6380

# Extra origins that sign-in should also trust, comma separated.
#
# FRONTEND_BASE_URL above is trusted on its own, so this is only for reaching the same
# deployment at a second address. The two below are the Vite dev servers, for running the
# dashboard from source against this stack.
#
# Ports matter: http://localhost and http://localhost:5173 are different origins and neither
# implies the other. Serving the UI on a port and listing only the bare host is the usual
# cause of a sign-in that 403s while every other page loads.
ADDITIONAL_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174


# =============================================================================
# 3. DATABASES
# =============================================================================
# Which MongoDB and Neo4j this stack connects to is NOT set here: it is .db.env, one file that
# every deployment on this machine reads (cp .env.db.example .db.env). Defining a database key
# here as well is refused by preflight.

# Redis, inside this compose network. Leave as-is unless you run Redis elsewhere.
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379


# =============================================================================
# 4. FILE STORAGE — repository source, generated specs, snapshots
# =============================================================================
# s3    — ingestion copies every indexed commit to YOUR bucket; MCP download links are S3
#         presigned URLs, so clients download straight from the bucket.
# local — nothing leaves this machine. Everything stays in ./temp, and the MCP servers serve
#         download links themselves at FRONTEND_BASE_URL/mcp/files/…, signed with a key derived
#         from JWT_SECRET. No S3 keys are read.
FILE_STORAGE_BACKEND=local
# The folder on this machine that every service mounts at /app/temp. Unset, it is ./temp beside
# this file. Point it elsewhere (e.g. ../templocal) to keep this stack's data apart from another
# stack on the same machine.
# TEMP_DIR=./temp
# In-container path of that mount. docker-compose sets it itself on the services that mount it,
# but email-dispatcher refuses to boot without it and gets it only from here.
KNOWLEDGE_BASE_PATH=/app/temp


# =============================================================================
# 5. SECRETS — generate these, do not invent them by hand
# =============================================================================
#   openssl rand -hex 32
#
# JWT_SECRET signs browser sessions AND derives the at-rest encryption key for
# every stored credential. Changing it later signs everyone out and makes
# previously stored secrets unreadable — set it once, back it up.  [REQUIRED]
JWT_SECRET=


# =============================================================================
# 6. PLAN
# =============================================================================
ENTERPRISE_PLAN=active
# false — the login page shows the email + password form (see 6c). true hides it.
PAY_PER_USER_MODE=false


# =============================================================================
# 6c. SIGN-IN — email + password only, no OAuth apps                 [REQUIRED]
# =============================================================================
# A localhost stack signs in with ONE superadmin account, by email and password. Every
# social button is switched off, so nobody has to register a GitHub, GitLab, Bitbucket or
# Google OAuth app — or be handed the keys of one — to use this stack. Repositories are
# reached with personal access tokens instead (section 8).
ENABLE_GITHUB_LOGIN=false
ENABLE_GITLAB=false
ENABLE_BITBUCKET=false
ENABLE_GOOGLE=false

# The superadmin account and its organisation. Created by `make superadmin localhost` once
# the stack is up — it seeds the organisation, creates this user in it, and promotes the
# user to superadmin. Run it again after changing a value here; it is idempotent.
SEED_ORG_NAME=localhost
SEED_CLIENT_EMAIL=admin@localhost
SEED_CLIENT_USERNAME=admin
SEED_CLIENT_PASSWORD=

# Addresses written onto that organisation; already correct for this compose file.
SEED_BACKEND_ADDRESS=http://knowledge-server:3001
SEED_CHAT_BACKEND_ADDRESS=http://localhost:8005
SEED_MCP_BACKEND_ADDRESS=http://localhost:8081/mcp
SEED_FRONTEND_ADDRESS=http://localhost:8081
SEED_ORG_DESCRIPTION=


# =============================================================================
# 6b. LLM — provider profiles                                          [REQUIRED]
# =============================================================================
# No provider key lives in this file. Each provider's complete configuration —
# its name, its credential, its model tiers, its endpoint locators — is one file
# under llm/, and these two lines name which ones the containers read. Copy the
# matching llm/*.env.example to llm/*.env and fill it in. A name given here must
# exist as a file, or the stack refuses to start.
#
#   LLM_PROFILE     answers, summaries, query enrichment — llm/<name>.env
#                   choices: openrouter, gemini, anthropic, openai
#   INGEST_PROFILE  the two ingestion phases (per-file, per-unit) — llm/ingest-<name>.env
#                   choices: openrouter, gemini, baseten, bedrock, anthropic, openai
#   FALLBACK_PROFILE  where calls go while the active provider refuses on capacity
#                   (429 / 503), for 120 s at a time — llm/fallback-<name>.env
#                   choices: openrouter, gemini, baseten, bedrock, anthropic, openai, none.
#                   Must differ from LLM_PROFILE.
#   AGENT_PROFILE   the public repository page's questions and pull-request reviews — llm/agent-<name>.env
#                   choices: baseten, openrouter, anthropic, openai
#
# Switching provider is changing one word here and running `make up` again.
#
# On a localhost stack, `./install.sh --env local` creates every llm/*.env that does not exist
# yet from its template, with the key set to `replace-me-in-stack-settings` — so the stack
# boots with every provider available, and the real keys are entered on the dashboard's
# Stack Settings page (which also switches these four). A placeholder key is not a working
# key: install.sh names every selected route still carrying one.
#
# This template names a real fallback: answers and ingestion on Gemini, and every call
# that Gemini refuses on capacity goes to OpenRouter for the next 120 s. The fallback
# must not be the provider it covers for, which is why it is not openrouter/openrouter.
# All four need their llm/*.env filled in — see llm/*.env.example for each.
LLM_PROFILE=gemini
INGEST_PROFILE=gemini
FALLBACK_PROFILE=openrouter
AGENT_PROFILE=baseten

# Per-call output ceilings, applied to every provider. 0 disables a cap.
LLM_REASONING_MAX_TOKENS=4000
LLM_MAX_COMPLETION_TOKENS=27000


# =============================================================================
# 6d. EMBEDDINGS — semantic search over past chats
# =============================================================================
# Always OpenRouter, whatever LLM_PROFILE names, on this key of its own. Ships with a dummy:
# enter the real key on the dashboard's Stack Settings page (Configuration → Stack Settings).
# The dimensions are the SHAPE of the Neo4j vector index: change them only together with the
# model (text-embedding-3-small → 1536, text-embedding-3-large → 3072); vectors from different
# models are not comparable.
EMBEDDINGS_API_KEY=replace-me-in-stack-settings
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536


# =============================================================================
# 7. PUBLIC REPO QUESTIONS (public-agent)
# =============================================================================
# Two replicas behind HAProxy at /api/v1/public/agent, answering questions about
# repositories you have published. Every value here is validated at boot.
#
# The three inference values MOVE TOGETHER: the base URL, the key that endpoint
# issued, and a model id that endpoint answers to. Mixing one provider's key with
# another's base is a 401 that reads like an expired key.
#
# The base must be an OpenAI-compatible API base INCLUDING the version segment.
# Reasoning is sent on every call (`chat_template_kwargs`), which vLLM-hosted
# models accept and the OpenAI API itself rejects.                  [REQUIRED]
# AGENT_LLM_BASE_URL / AGENT_LLM_API_KEY / AGENT_MODEL live in llm/agent-<name>.env, named by
# AGENT_PROFILE above — copy llm/agent-baseten.env.example to llm/agent-baseten.env and fill it.
# Compose loads that file AFTER this one, so a copy left here is shadowed rather than used.

# ── Optional ─────────────────────────────────────────────────────────────────
# Spend brakes on an endpoint anonymous visitors can reach. Defaults shown; set
# them only to change them. Every question funds a multi-turn model run.
# PUBLIC_AGENT_RATE_LIMIT_PER_VISITOR=3
# PUBLIC_AGENT_RATE_LIMIT_PER_REPO=50
# PUBLIC_AGENT_RATE_LIMIT_WINDOW_SECONDS=86400
#
# Fallback MCP endpoint, used only for a publishing organisation that carries no
# address of its own. The organisation's own value wins.
# MCP_BACKEND_ADDRESS=


# =============================================================================
# 8. GIT PROVIDERS — tokens, not OAuth apps
# =============================================================================
# No OAuth app is registered for a localhost stack, so these stay BLANK. Sign-in is by
# email + password (6c), and the git hosts are reached with the tokens below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your OWN personal access tokens, one per git host you index from. With the fallback on,
# a repository whose organisation holds no token of its own is read with the matching one
# here — so a developer needs nothing beyond a token they already have. A token pasted
# when adding a repository in the dashboard is used ahead of these.
ENABLE_TOKEN_ENV_FALLBACK=true
PERSONAL_ACCESS_TOKEN=
GITLAB_TOKEN=
BITBUCKET_TOKEN=


# =============================================================================
# 9. FEATURES — off unless you need them
# =============================================================================
ENABLE_PDF=false
ENABLE_WEBSITE=false
