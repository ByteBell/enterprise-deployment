# =============================================================================
# Plumbline — which databases this machine's stack connects to
# =============================================================================
#
#   cp .env.db.example .db.env
#
# ONE file, read by every deployment on this machine — `make up dev`, `make up local`,
# `make up prod` and ./install.sh alike — on top of that deployment's own env file. Switching
# the stack between the local containers, production, or any other database is an edit here
# and nothing else. The deployment env files (.dev.env, .localhost.env, .production.env) must
# NOT define any key below: preflight refuses a key defined in both, because the losing
# definition would still read as though it were in force.
#
# The `mongodb` and `neo4j` containers of docker-compose.yml start exactly when the URIs below
# name them (hosts `mongodb` / `neo4j`), and not otherwise. prod refuses to start while they do:
# production never runs its databases in this compose file.
#
# `.db.env` is gitignored and never leaves your machine.
# =============================================================================

# MongoDB — the `mongodb` container, reached by name over the compose network, with auth ON.
# The user and password in this URI ARE the database's: the first start creates that user.
# Change the password later from the dashboard's Stack Settings page, which changes it inside
# the database and rewrites this line — editing only this line afterwards locks the stack out.
# Anywhere else (Atlas, self-hosted): that connection string instead.   [REQUIRED]
MONGODB_URI=mongodb://plumbline:plumbline-local@mongodb:27017/?authSource=admin&directConnection=true

# Database names inside that MongoDB. The defaults are what ByteBell provisions;
# change them only if you were told to.
ADMIN_DATABASE_NAME=app_backend_v2
KNOWLEDGE_DATABASE_NAME=knowledge_backend_v2
PUBLIC_AGENT_DATABASE_NAME=public_agent_v2

# Neo4j — the code knowledge graph — the `neo4j` container. The password is what the container
# is CREATED with on first start and what every service connects with; change it later from
# Stack Settings, as with MongoDB. Another machine: bolt://<private-ip>:7687.   [REQUIRED]
ENABLE_NEO4J=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=plumbline-local
NEO4J_DATABASE=neo4j

# Where the local containers are published on THIS machine, loopback only — mongosh and the
# Neo4j browser, for triage. Move one when its port is already taken; the services never use them.
MONGODB_HOST_PORT=27017
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687
