# =============================================================================
# Plumbline — enterprise deployment
# =============================================================================
#
#   cp .env.example .env    then fill in every [REQUIRED] value below.
#
# `.env` is gitignored and never leaves your server. Everything here is read at
# container START: a service missing a required value exits immediately with the
# variable's name, rather than failing later on a user's first request.
#
# Values with a default shown are already correct for a standard deployment —
# change them only if you know why.
# =============================================================================


# =============================================================================
# 1. IMAGES — where they come from                                  [REQUIRED]
# =============================================================================
# Every service ships from ONE private Docker Hub repository, told apart by tag:
#
#     docker.io/bbplumbline/plumbline-containers:ingestion-engine-5.0.2
#      └registry┘ └namespace ┘ └──── repo ────┘ └─── service ───┘└ ver ┘
#
# so IMAGE_REPO_PREFIX is the NAMESPACE and never contains a slash.
IMAGE_REGISTRY=docker.io
IMAGE_REPO_PREFIX=bbplumbline
IMAGE_REPO_NAME=plumbline-containers

# The release you are running. There is no `latest` tag in this repository, so an
# unset IMAGE_TAG makes every pull fail with a 404 — set it explicitly, and change
# it to upgrade.
IMAGE_TAG=5.0.2

# Read-only Docker Hub credentials, issued to you by ByteBell. `make login` reads
# these. They can pull and nothing else.
REGISTRY_USERNAME=
REGISTRY_TOKEN=


# =============================================================================
# 2. CORE
# =============================================================================
# `development` disables authentication. Never set that on a reachable host.
NODE_ENV=production

# Absolute path to THIS directory, e.g. /opt/plumbline.             [REQUIRED]
COMPOSE_PROJECT_DIR=
COMPOSE_PROJECT_NAME=plumbline

# Where the browser reaches this deployment — used in links the services generate
# (invites, OAuth callbacks). Include the scheme, no trailing slash. [REQUIRED]
FRONTEND_BASE_URL=


# =============================================================================
# 3. DATABASES
# =============================================================================
# MongoDB connection string — Atlas, self-hosted, or a container you run
# alongside this stack.                                             [REQUIRED]
MONGODB_URI=

# Database names inside that MongoDB. The defaults are what ByteBell provisions;
# change them only if you were told to.
ADMIN_DATABASE_NAME=app_backend_v2
KNOWLEDGE_DATABASE_NAME=knowledge_backend_v2
PUBLIC_AGENT_DATABASE_NAME=public_agent_v2

# Redis, inside this compose network. Leave as-is unless you run Redis elsewhere.
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# Neo4j — the code knowledge graph. Same host: bolt://neo4j:7687.
# Another machine: bolt://<private-ip>:7687.                        [REQUIRED]
ENABLE_NEO4J=true
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j


# =============================================================================
# 4. FILE STORAGE — repository source, generated specs, snapshots
# =============================================================================
# s3 | fileserver
FILE_STORAGE_BACKEND=s3

# The bucket holding the above. YOUR bucket, in YOUR account.       [REQUIRED]
S3_FILES_BUCKET=
AWS_DEFAULT_REGION=us-east-1

# YOUR credentials for YOUR bucket — they need S3 read/write on S3_FILES_BUCKET
# and nothing else. LEAVE BOTH BLANK on an EC2 instance with an IAM role
# attached; the SDK picks the role up automatically and a blank is safer than a
# long-lived key on disk.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# =============================================================================
# 5. SECRETS — generate these, do not invent them by hand
# =============================================================================
#   openssl rand -hex 32
#
# JWT_SECRET signs browser sessions AND derives the at-rest encryption key for
# every stored credential. Changing it later signs everyone out and makes
# previously stored secrets unreadable — set it once, back it up.  [REQUIRED]
JWT_SECRET=

# Guards the local update API that system-manager exposes.          [REQUIRED]
UPDATE_API_TOKEN=


# =============================================================================
# 6. LICENCE
# =============================================================================
# false — managed: system-manager fetches config and licence from ByteBell every
#         two minutes, and CLIENT_ID + LICENSE_KEY are required.
# true  — standalone: no outbound connection to ByteBell is ever made, this file
#         becomes the only source of configuration, and the licence check is
#         skipped. You then fill in every value yourself and updates are manual.
STANDALONE_MODE=false

# Provided during onboarding.        [REQUIRED unless STANDALONE_MODE=true]
CLIENT_ID=
LICENSE_KEY=

ENTERPRISE_PLAN=active
PAY_PER_USER_MODE=false


# =============================================================================
# 7. PUBLIC REPO QUESTIONS (public-agent)
# =============================================================================
# Two replicas behind HAProxy at /api/v1/public/agent, answering questions about
# repositories you have published. Every value here is validated at boot.
#
# The three inference values MOVE TOGETHER: the base URL, the key that endpoint
# issued, and a model id that endpoint answers to. Mixing one provider's key with
# another's base is a 401 that reads like an expired key.
#
# The base must be an OpenAI-compatible API base INCLUDING the version segment.
# Reasoning is sent on every call (`chat_template_kwargs`), which vLLM-hosted
# models accept and the OpenAI API itself rejects.                  [REQUIRED]
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_MODEL=

# ── Optional ─────────────────────────────────────────────────────────────────
# Spend brakes on an endpoint anonymous visitors can reach. Defaults shown; set
# them only to change them. Every question funds a multi-turn model run.
# PUBLIC_AGENT_RATE_LIMIT_PER_VISITOR=3
# PUBLIC_AGENT_RATE_LIMIT_PER_REPO=50
# PUBLIC_AGENT_RATE_LIMIT_WINDOW_SECONDS=86400
#
# Fallback MCP endpoint, used only for a publishing organisation that carries no
# address of its own. The organisation's own value wins.
# MCP_BACKEND_ADDRESS=


# =============================================================================
# 8. GIT PROVIDERS — only what you actually connect
# =============================================================================
# OAuth apps you register yourself. Required in STANDALONE_MODE; in managed mode
# ByteBell's auth proxy supplies them unless you override here.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# A personal access token used for repository reads where no OAuth app applies.
PERSONAL_ACCESS_TOKEN=


# =============================================================================
# 9. FEATURES — off unless you need them
# =============================================================================
ENABLE_PDF=false
ENABLE_WEBSITE=false
